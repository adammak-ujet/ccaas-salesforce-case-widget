# Copy to .env for local testing (this file, .env.example, is safe to commit —
# .env is gitignored and is where your real values belong; never put real
# secrets here).
#
# functions-framework does NOT auto-load .env. This project's dev scripts use
# dotenv-cli to load it automatically, so `npm run dev:listCases` etc. just work
# once `.env` exists and `npm install` has run.
# In Cloud Run, set these as env vars / Secret Manager secrets on each function instead.

# https://login.salesforce.com for prod/dev orgs, https://test.salesforce.com for sandboxes,
# or your org's My Domain URL (recommended by Salesforce).
SF_LOGIN_URL=https://login.salesforce.com

# Consumer Key from the Connected App / External Client App (see ../README.md for setup steps).
SF_CONSUMER_KEY=

# Username of the Salesforce user the app is pre-authorized to run as.
SF_USERNAME=integration-user@yourorg.com

# PEM-encoded RSA private key matching the certificate uploaded to the app.
# Paste with literal \n for newlines if setting this as a one-line env var / secret.
SF_PRIVATE_KEY=

# Optional, defaults to v60.0
SF_API_VERSION=v60.0

# Your GitHub Pages origin, e.g. https://yourorg.github.io
ALLOWED_ORIGIN=

# Optional shared key the widget sends as X-Widget-Key (basic anti-scraping only).
WIDGET_API_KEY=
